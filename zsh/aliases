# rm: с флагами r+f — настоящее удаление, иначе — в корзину
(( $+aliases[rm] )) && unalias rm  # на случай повторного source со старым алиасом в сессии
rm() {
	if ! command -v trash >/dev/null 2>&1; then command rm "$@"; return; fi
	local flags="" args=() arg noMoreOpts=0
	for arg in "$@"; do
		if (( noMoreOpts )) || [[ $arg != -* || $arg == - ]]; then
			args+=("$arg")
		elif [[ $arg == -- ]]; then
			noMoreOpts=1
		else
			flags+="${arg#-}"
		fi
	done
	if [[ $flags == *[rR]* && $flags == *[fF]* ]]; then
		command rm "$@"       # -rf/-fr и т.п. — по-настоящему
	else
		(( ${#args} )) || return 1
		trash -v "${args[@]}" # остальное — в корзину
	fi
}
