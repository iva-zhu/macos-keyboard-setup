# ── AeroSpace (mac) ───────────────────────────────────────────────
if [[ $OSTYPE == darwin* ]] && command -v aerospace >/dev/null 2>&1 && command -v fzf >/dev/null 2>&1; then
	# ff: выбрать окно AeroSpace через fzf и переключиться на него
	ff() {
		aerospace list-windows --all \
			| fzf --prompt='window ❯ ' --delimiter='|' --with-nth=2,3 \
				--bind 'enter:execute-silent(bash -c "aerospace focus --window-id {1}")+abort'
	}
fi
