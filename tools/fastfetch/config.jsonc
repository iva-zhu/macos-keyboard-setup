// fastfetch: compact grouped system summary (distro / DE-WM / system / colors).

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "Auto"
      },
  "display": {
    "separator": "  ➜  ",
    "color": {
      "keys": "magenta",
      "title": "blue"
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": ""
    },
    // --- ГРУППА DISTRO ---
    {
      "type": "custom",
      "format": "\u001b[1;35m󰊠 DISTRO\u001b[0m" // Универсальная иконка дистрибутива/ОС
    },
    {
      "type": "os",
      "key": " ├─ 󰀵", // Иконка операционки
      "keyColor": "35",
      "format": "{2} {8}"
    },
    {
      "type": "kernel",
      "key": " ├─ 󰒋", // Нейтральная иконка ядра системы (подходит и Darwin, и Linux)
      "keyColor": "35",
      "format": "{2}"
    },
    {
      "type": "packages",
      "key": " ├─ 󰏖",
      "keyColor": "35",
      "countUnknown": true
    },  
    {
      "type": "shell",
      "key": " └─ 󰞷",
      "keyColor": "35"
    },

    {
      "type": "custom",
      "format": ""
    },

    // --- ГРУППА DE/WM ---
    {
      "type": "custom",
      "format": "\u001b[1;36m DE/WM\u001b[0m"
    },
    {
      "type": "wm",
      "key": " ├─ 󰨇",
      "keyColor": "36",
      "format": "{1}"
    },
    {
      "type": "terminal",
      "key": " ├─ ",
      "keyColor": "36"
    },
    {
      "type": "uptime",
      "key": " └─ 󱎫",
      "keyColor": "36"
    },

    {
      "type": "custom",
      "format": ""
    },

    // --- ГРУППА SYSTEM ---
    {
      "type": "custom",
      "format": "\u001b[1;34m󰍹 SYSTEM\u001b[0m"
    },
    {
      "type": "cpu",
      "key": " ├─ 󰻠",
      "keyColor": "34",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": " ├─ 󰢮",
      "keyColor": "34",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": " ├─ 󰍛",
      "keyColor": "34"
    },
    {
      "type": "disk",
      "key": " ├─ 󰋊 SYS",
      "keyColor": "34",
      "folders": "/"
    },
    {
      "type": "disk",
      "key": " ├─ 󰋊 GMS",
      "keyColor": "34",
      "folders": "/mnt/games" // Автоматически скроется на macOS, так как пути нет
    },
    {
      "type": "disk",
      // На Arch это будет последней веткой (└─), на macOS предпоследняя скроется,
      // поэтому используем универсальный красивый разделитель для дисков
      "key": " └─ 󰋊 HDD", 
      "keyColor": "34",
      "folders": "/mnt/hdd" // Также скроется на macOS
    },

    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
